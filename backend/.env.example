DATABASE_URL=postgresql+asyncpg://luz:luz@localhost:5432/luzalerts
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=your@email.com
REPORT_RADIUS_M=500
REPORT_THRESHOLD=3
ADMIN_API_KEY=change-me-before-prod

# Web Push для PWA на iOS (app.luzalerts.lat). Сгенерировать пару ключей:
#   npx web-push generate-vapid-keys
# или: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); v.save_key('private_key.pem'); v.save_public_key('public_key.pem')"
# Пустой VAPID_PRIVATE_KEY = web push выключен, пустой VAPID_PUBLIC_KEY = /config/vapid-public-key отвечает 503.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://luzalerts.lat
# Origins, которым разрешен CORS (через запятую). Нативному приложению CORS не нужен.
CORS_ORIGINS=https://app.luzalerts.lat,http://localhost:8081,http://localhost:19006
