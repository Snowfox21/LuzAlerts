luzalerts.lat {
    encode gzip

    handle /outages* {
        reverse_proxy backend:8000
    }
    handle /reports* {
        reverse_proxy backend:8000
    }
    handle /users* {
        reverse_proxy backend:8000
    }
    handle /subscriptions* {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/web
        try_files {path} {path}/index.html {path}.html /404.html
        file_server
    }
}
