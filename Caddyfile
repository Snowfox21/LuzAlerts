luzalerts.lat {
    encode gzip

    # API routes → FastAPI backend
    handle /outages* {
        reverse_proxy backend:8000
    }
    handle /reports* {
        reverse_proxy backend:8000
    }
    handle /users* {
        reverse_proxy backend:8000
    }
    handle /subscriptions* {
        reverse_proxy backend:8000
    }

    # Root path → index.html
    handle =/ {
        root * /srv/web
        file_server {
            index index.html
        }
    }

    # All other pages (e.g. /privacy → privacy.html)
    handle {
        root * /srv/web
        try_files {path} {path}.html /404.html
        file_server
    }
}
