luzalerts.lat {
    encode gzip

    handle /status {
        reverse_proxy backend:8000
    }
    handle /events.json {
        reverse_proxy backend:8000
    }
    handle /outages* {
        reverse_proxy backend:8000
    }
    handle /reports* {
        reverse_proxy backend:8000
    }
    handle /users* {
        reverse_proxy backend:8000
    }
    # Публичная страница метки для шеринга. Рендерит бэкенд, а не file_server:
    # og-теги нужны готовыми в HTML, краулер WhatsApp не исполняет JS.
    handle /r/* {
        reverse_proxy backend:8000
    }
    # То же для официального отключения ANDE (шеринг семье в WhatsApp).
    handle /o/* {
        reverse_proxy backend:8000
    }
    handle /subscriptions* {
        reverse_proxy backend:8000
    }
    # Публичный VAPID-ключ для Web Push подписки PWA (luzalerts.lat/app).
    handle /config* {
        reverse_proxy backend:8000
    }
    # Адрес по координатам для PWA (в браузере нет reverseGeocodeAsync).
    handle /geocode* {
        reverse_proxy backend:8000
    }

    # PWA для iPhone: тот же код mobile/, собранный `expo export -p web`
    # с experiments.baseUrl=/app (см. scripts/deploy-pwa.sh).
    redir /app /app/ 308
    handle_path /app/* {
        # Бандлы expo export с хэшем в имени — можно кэшировать надолго.
        @hashed path /_expo/static/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        # Все остальное (index.html и SPA-фоллбэк на нем, sw.js, manifest.json)
        # не кэшируем: иначе iOS держит старый sw.js/index.html, и новая сборка
        # и логика пушей не доезжают до установленных PWA.
        @nothashed not path /_expo/static/*
        header @nothashed Cache-Control "no-cache"

        root * /srv/app-web
        # SPA-фоллбэк на index.html: маршруты разбирает клиентский роутер
        # expo-router, а не статические страницы как у лендинга.
        try_files {path} {path}.html /index.html
        file_server
    }

    handle {
        root * /srv/web
        try_files {path} {path}/index.html {path}.html /404.html
        file_server
    }
}

# Старый адрес PWA: редирект на luzalerts.lat/app с сохранением пути.
app.luzalerts.lat {
    redir https://luzalerts.lat/app{uri} 308
}
